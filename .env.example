# 必填：外置 PostgreSQL 连接串。请按实际地址、账号、SSL 策略修改。
DATABASE_URL=postgres://dochub:dochub-local-password@postgres.example.com:5432/dochub?sslmode=require

APP_ADDR=127.0.0.1:8080
DATA_DIR=./data
STORAGE_DIR=../data
WEB_DIR=../web/dist
SESSION_TTL=168h

# 必填：首次启动时创建管理员。管理员存在后该值不会覆盖原有账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password

# 必填：仅允许服务访问这些 Git 主机，多个主机使用英文逗号分隔。
GIT_HOST_ALLOWLIST=git.example.com

# SSH 凭据挂载到容器后由 entrypoint 复制给运行用户。
SSH_KEY_FILE=${HOME}/.ssh/id_ed25519
SSH_KNOWN_HOSTS_FILE=${HOME}/.ssh/known_hosts

# 后端在本机直接运行时使用。留空时读取当前用户的默认 SSH 配置。
SSH_KEY_PATH=
SSH_KNOWN_HOSTS_PATH=

# 通过 HTTPS 反向代理访问时打开。
COOKIE_SECURE=false
